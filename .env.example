# ============================================================
# SAA29 – Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA versione o arquivo .env no Git.
# ============================================================

# --- Banco de Dados ---
# SQLite é o banco padrão para instalação local/monousuário.
# Para PostgreSQL em produção, descomente a linha abaixo e comente a de SQLite.
DATABASE_URL=sqlite+aiosqlite:///./saa29_local.db
# DATABASE_URL=postgresql+asyncpg://saa29_user:senha_segura@localhost:5432/saa29_db

# --- Aplicação ---
APP_ENV=development          # development | production
APP_DEBUG=True
APP_SECRET_KEY=TROQUE_POR_UMA_CHAVE_SECRETA_LONGA_E_ALEATORIA
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASSWORD=GERE_UMA_SENHA_FORTE_DE_16_CARACTERES_AQUI
# Flag temporária: redefine a senha do admin para DEFAULT_ADMIN_PASSWORD no
# próximo boot/seed (cenário de restore de banco). Remova depois de usar.
ADMIN_PASSWORD_RESET=false
ENABLE_DEV_SEEDS=false
ENABLE_TEST_USERS=false
# Força o atributo Secure nos cookies de sessão mesmo fora de APP_ENV=production
# (ex: staging/homolog atrás de HTTPS).
FORCE_SECURE_COOKIES=false

# --- JWT ---
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480       # 8 horas

# --- Upload e Storage ---
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
STORAGE_BACKEND=local # local | r2

# --- Cloudflare R2 (Descomente para usar storage R2) ---
# R2_ACCOUNT_ID=sua_account_id
# R2_ACCESS_KEY_ID=sua_access_key
# R2_SECRET_ACCESS_KEY=sua_secret_key
# R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# R2_BUCKET_NAME=saa29-storage

# --- Módulo Publicações ---
# Acervo de manuais (PDFs). Regenerável a partir da mídia de publicação — está
# no .gitignore e NUNCA entra no repositório.
PUBLICACOES_ACERVO_DIR=var/publicacoes/acervo
# Índice de busca full-text. SQLite dedicado, gerado offline por
# `python -m scripts.publicacoes.indexar` — fora do DATABASE_URL de propósito.
PUBLICACOES_INDEX_PATH=var/publicacoes/catalog.db
PUBLICACOES_CATEGORIAS_PATH=config/categorias_manuais.toml
# Anexo de BO/BS/NPO/BT: limite próprio, bem maior que MAX_UPLOAD_SIZE_MB.
PUBLICACOES_AVULSAS_MAX_UPLOAD_MB=50
PUBLICACOES_EDICOES_RETIDAS=2
PUBLICACOES_SNAPSHOTS_RETIDOS=3
